# Copy this file to .env to use this Supabase project's public configuration.
# Commit this template; keep .env ignored. EXPO_PUBLIC_ values enter the app bundle.
# Use a public publishable/anon key only. Never put a service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://nuwunxzibsvvtnxjjqzj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_v7eQbiVje3rA3X3BXHm3vw_0PCz06wy

# Set false to use the earlier questionnaire and Traseu during rollout.
EXPO_PUBLIC_EDUCATIONAL_ROUTES=true

# Published responder URL, never the Google Form editor URL.
# Leave empty until the reviewed application form is published by the team.
EXPO_PUBLIC_TEACHER_APPLICATION_FORM_URL=

# Keep unavailable integrations hidden until their live end-to-end checks pass.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
EXPO_PUBLIC_TUTORING_BOOKINGS_ENABLED=false
# Optional pilot contact. Settings also offers a shareable problem report.
EXPO_PUBLIC_FEEDBACK_EMAIL=
# Server-only Stripe webhook signing secret. Configure in Supabase function secrets;
# never prefix with EXPO_PUBLIC_ or put it in the mobile bundle.
STRIPE_WEBHOOK_SECRET=
