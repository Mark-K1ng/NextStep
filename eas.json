{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "developmentClient": false,
      "android": { "buildType": "apk" },
      "env": {
        "GRADLE_OPTS": "-Dorg.gradle.workers.max=1 -Dorg.gradle.parallel=false -Dorg.gradle.daemon=false -Dorg.gradle.jvmargs=-Xmx3g",
        "EXPO_PUBLIC_EDUCATIONAL_ROUTES": "true",
        "EXPO_PUBLIC_GOOGLE_AUTH_ENABLED": "false",
        "EXPO_PUBLIC_APPLE_AUTH_ENABLED": "false",
        "EXPO_PUBLIC_TUTORING_BOOKINGS_ENABLED": "false"
      }
    }
  }
}
