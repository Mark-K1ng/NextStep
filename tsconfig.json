{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "node_modules/**",
    "node_modules/expo-modules-core",
    "node_modules/expo-modules-core/**",
    "supabase/functions"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
