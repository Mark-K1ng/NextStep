    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.26",
    "@nextstep/ascii-reveal-native": "file:./packages/ascii-reveal-native",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.20",
    "expo-web-browser": "~58.0.7",
