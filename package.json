    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-native-community/eslint-config": "^3.2.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "^19.0.0-beta-ebf51a3-20250411",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^16.0.0",
    "eslint-plugin-jest": "^29",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-mcp": "0.3.1",
    "fallow": "^3.33.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "jsxSingleQuote": true,
    "printWidth": 80,
    "proseWrap": "preserve",
    "singleQuote": true,
    "semi": true,
    "singleAttributePerLine": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run lint && npm run typecheck && npm test -- --runInBand && npm run check:edge",
    "test:edge": "npx --yes deno@2.9.6 test --config supabase/functions/deno.json --allow-env=SUPABASE_URL,SUPABASE_SERVICE_ROLE_KEY,SUPABASE_ANON_KEY,STRIPE_WEBHOOK_SECRET,STRIPE_SECRET_KEY supabase/functions/tests",
    "typecheck:edge": "npx --yes deno@2.9.6 check --config supabase/functions/deno.json supabase/functions/export-data/index.ts supabase/functions/delete-account/index.ts supabase/functions/explain-path/index.ts supabase/functions/tutoring-payments/index.ts supabase/functions/tutoring-webhook/index.ts supabase/functions/educational-route/index.ts",
    "check:edge": "npx --yes deno@2.9.6 lint supabase/functions && npm run typecheck:edge && npm run test:edge",
    "preview:phone": "expo start --go --no-dev --minify"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo-mcp"
      ]
    }
  }
}
