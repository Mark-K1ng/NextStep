{
  "expo": {
    "name": "NextStep",
    "slug": "nextstep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nextstep",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nextstep.app",
      "associatedDomains": [
        {
          "domains": ["*.supabase.co"],
          "scheme": "nextstep"
        }
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18171F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.nextstep.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "nextstep"
            }
          ],
          "category": "BROWSABLE",
          "autoVerify": true
        }
      ],
      "windowSoftInputMode": "adjustResize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5743160c-570e-47a9-9465-69fff216c3ea"
      }
    }
  }
}
